<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Warm MVP palette -->
    <Color x:Key="Primary">#5B8C5A</Color>
    <Color x:Key="Secondary">#E6C97A</Color>
    <Color x:Key="Tertiary">#F4EEDC</Color>
    
    <!-- Backgrounds -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#171C17</Color> <!-- Dark Mode Background -->
    
    <!-- Surfaces & Borders -->
    <Color x:Key="Gray100">#F2EADF</Color> <!-- Light Surface 1 -->
    <Color x:Key="Gray200">#EFE6D8</Color> <!-- Light Surface 2 -->
    <Color x:Key="Gray300">#CFC2A9</Color> <!-- Light Border -->
    <Color x:Key="Gray400">#919191</Color> 
    <Color x:Key="Gray500">#B2B2A3</Color> <!-- Dark Muted Text -->
    <Color x:Key="Gray600">#7F6F4B</Color> <!-- Light Muted Text -->
    
    <!-- Texts & Dark Surfaces -->
    <Color x:Key="Gray900">#5A4D39</Color> <!-- Light Text Foreground -->
    <Color x:Key="Gray950">#1B221B</Color> <!-- Dark Surface 1 -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#28C2D1</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>
    <Color x:Key="Blue100Accent">#3E8EED</Color>
    <Color x:Key="Blue200Accent">#72ACF1</Color>
    <Color x:Key="Blue300Accent">#A7CBF6</Color>
    <Color x:Key="Destructive">#EF4444</Color>

    <!-- Specific Semantic Theme Colors based on Next.js -->
    <Color x:Key="AppBackgroundLight">#F4EEDC</Color>
    <Color x:Key="AppBackgroundDark">#171C17</Color>
    <Color x:Key="AppSurface1Light">#F2EADF</Color>
    <Color x:Key="AppSurface1Dark">#1B221B</Color>
    <Color x:Key="AppSurface2Light">#EFE6D8</Color>
    <Color x:Key="AppSurface2Dark">#222A22</Color>
    <Color x:Key="AppForegroundLight">#5A4D39</Color>
    <Color x:Key="AppForegroundDark">#F4EEDC</Color>
    <Color x:Key="AppMutedForegroundLight">#75633F</Color>
    <Color x:Key="AppMutedForegroundDark">#B2B2A3</Color>

    <Color x:Key="AppInputLight">#F4EEDC</Color>
    <Color x:Key="AppNavActiveLight">#E7E8D0</Color>
    <Color x:Key="AppProgressTrackLight">#E8DEC8</Color>
    <Color x:Key="AppWarningLight">#E6C97A</Color>

</ResourceDictionary>
