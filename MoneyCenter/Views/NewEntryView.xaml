<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MoneyCenter.ViewModel"
             xmlns:icons="clr-namespace:MoneyCenter.Views.Icons"
             x:Class="MoneyCenter.Views.NewEntryView"
             x:DataType="vm:NewEntryViewModel"
             BackgroundColor="#CC000000">

    <Grid Padding="16">
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center">
            <Border Style="{StaticResource PanelStyle}"
                    BackgroundColor="{StaticResource AppBackgroundLight}"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="512"
                    Padding="24">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,36">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Add a New Expense"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="Log a new transaction for this month."
                                   TextColor="{StaticResource AppMutedForegroundLight}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{x:Static icons:MaterialIcon.Close}"
                                Command="{Binding CloseCommand}"
                                FontFamily="MaterialIcon"
                                FontSize="20"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                TextColor="{StaticResource AppMutedForegroundLight}"
                                WidthRequest="36"
                                HeightRequest="36"
                                MinimumWidthRequest="36"
                                MinimumHeightRequest="36"
                                Padding="0" />
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Expense Destination" />
                        <Entry Placeholder="Select or type destination..."
                               Text="{Binding NewEntryModel.Store}"
                               BackgroundColor="{StaticResource AppInputLight}"
                               HeightRequest="40"
                               MinimumHeightRequest="40" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Category" />
                        <Border Style="{StaticResource InputBorderStyle}" Padding="12,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding SelectedCategory.Name, TargetNullValue='Select or create category...'}"
                                       TextColor="{StaticResource AppMutedForegroundLight}"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Text="{x:Static icons:MaterialIcon.Expand_more}"
                                       FontFamily="MaterialIcon"
                                       FontSize="20"
                                       TextColor="{StaticResource AppMutedForegroundLight}"
                                       VerticalOptions="Center" />
                                <Picker Grid.ColumnSpan="2"
                                        Title="Select or create category..."
                                    ItemsSource="{Binding MasterCategories}"
                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding Name}"
                                        Opacity="0.01"
                                        HeightRequest="40" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description (Optional)" />
                        <Editor Placeholder="e.g., Weekly groceries, new headphones"
                                Text="{Binding NewEntryModel.Details}"
                                BackgroundColor="{StaticResource AppInputLight}"
                                HeightRequest="82"
                                MinimumHeightRequest="82" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Date" />
                            <Border Style="{StaticResource InputBorderStyle}" Padding="12,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding NewEntryModel.Date, StringFormat='{0:MMMM d\\, yyyy}'}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{x:Static icons:MaterialIcon.Calendar_today}"
                                           FontFamily="MaterialIcon"
                                           TextColor="{StaticResource AppMutedForegroundLight}"
                                           FontSize="18"
                                           VerticalOptions="Center" />
                                    <DatePicker Grid.ColumnSpan="2"
                                                Date="{Binding NewEntryModel.Date}"
                                                Opacity="0.01"
                                                HeightRequest="40" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Amount" />
                            <Entry Keyboard="Numeric"
                                   HorizontalTextAlignment="End"
                                   BackgroundColor="{StaticResource AppInputLight}"
                                   HeightRequest="40"
                                   MinimumHeightRequest="40"
                                   Text="{Binding NewEntryModel.Amount}" />
                        </VerticalStackLayout>
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,8,0,0">
                        <Button Text="Cancel"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Text="Add Expense"
                                Command="{Binding SaveCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
