<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoneyCenter.ViewModel"
             xmlns:icons="clr-namespace:MoneyCenter.Views.Icons"
             x:Class="MoneyCenter.Views.SettingsView"
             x:DataType="viewmodel:SettingsViewModel"
             x:Name="RootView"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ScrollView>
        <Border Style="{StaticResource PanelStyle}"
                Margin="{Binding Source={x:Reference RootView}, Path=IsDesktop, Converter={StaticResource BoolToObjectConverter}, ConverterParameter='0|16'}"
                Padding="{Binding Source={x:Reference RootView}, Path=IsDesktop, Converter={StaticResource BoolToObjectConverter}, ConverterParameter='24|16'}">
            <VerticalStackLayout Spacing="24">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Label Text="{x:Static icons:MaterialIcon.Account_balance_wallet}"
                           FontFamily="MaterialIcon"
                           FontSize="40"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="Pocket Ledger" FontSize="24" FontAttributes="Bold" />
                        <Label Text="App Settings &amp; Data Management"
                               TextColor="{StaticResource AppMutedForegroundLight}" />
                    </VerticalStackLayout>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Export Data" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Download all your financial data, including income, expenses, and savings goals, as a single JSON file."
                                   TextColor="{StaticResource AppMutedForegroundLight}" />
                        </VerticalStackLayout>
                        <Border Style="{StaticResource PrimaryActionBorderStyle}"
                                HorizontalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExportDataCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="{x:Static icons:MaterialIcon.Download}"
                                       Style="{StaticResource PrimaryActionIconTextStyle}" />
                                <Label Text="Download JSON File"
                                       Style="{StaticResource PrimaryActionLabelTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentView>
