<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoneyCenter.ViewModel"
             xmlns:objects="clr-namespace:MoneyCenter.ViewModel.Objects"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MoneyCenter.Views.ExpensesView"
             x:DataType="viewmodel:ExpensesViewModel"
             x:Name="RootView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="10" RowSpacing="10">

        <Label Grid.Row="0" Text="Expense Tracker" FontSize="24" FontAttributes="Bold" />

        <Button Grid.Row="1" Text="Add Previous Year" Command="{Binding AddPreviousYearCommand}" />

        <!-- Year Hierarchy — ScrollView + BindableLayout avoids CollectionView unbounded-height issue -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding Years}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:YearViewModel">
                        <toolkit:Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <toolkit:Expander.Header>
                                <Label Text="{Binding YearValue}" FontAttributes="Bold" Padding="5" />
                            </toolkit:Expander.Header>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Months}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:MonthViewModel">
                                        <toolkit:Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <toolkit:Expander.Header>
                                                <Grid ColumnDefinitions="2*,*,Auto,Auto" Padding="5">
                                                    <VerticalStackLayout Grid.Column="0">
                                                        <Label Text="{Binding MonthName}" FontAttributes="Bold" />
                                                        <Label Text="{Binding TransactionCount, StringFormat='Transactions: {0}'}" FontSize="12" />
                                                    </VerticalStackLayout>
                                                    <Picker Grid.Column="1"
                                                            ItemsSource="{Binding AllBudgets}"
                                                            SelectedItem="{Binding SelectedBudget, Mode=TwoWay}"
                                                            ItemDisplayBinding="{Binding Name}" />
                                                    <Button Grid.Column="2" Text="+" Command="{Binding AddExpenseCommand}" WidthRequest="40" />
                                                    <Button Grid.Column="3" Text="˅" Command="{Binding ToggleExpandCommand}" WidthRequest="40" />
                                                </Grid>
                                            </toolkit:Expander.Header>

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="objects:Expense">
                                                        <Grid Padding="10,5" ColumnDefinitions="*,Auto,Auto">
                                                            <VerticalStackLayout Grid.Column="0">
                                                                <Label Text="{Binding Destination}" FontAttributes="Bold" />
                                                                <Label Text="{Binding CategoryName}" FontSize="12" TextColor="Gray" />
                                                                <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12" TextColor="Gray" />
                                                                <Label Text="{Binding Details}" FontSize="12" />
                                                            </VerticalStackLayout>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Amount, StringFormat='${0:F2}'}"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   Margin="5,0" />
                                                            <Button Grid.Column="2"
                                                                    Text="🗑"
                                                                    Command="{Binding DeleteCommand}"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="Red"
                                                                    WidthRequest="40" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </toolkit:Expander>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </toolkit:Expander>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="3" Text="Add Next Year" Command="{Binding AddNextYearCommand}" />

    </Grid>
</ContentView>