<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoneyCenter.ViewModel"
             xmlns:objects="clr-namespace:MoneyCenter.ViewModel.Objects"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MoneyCenter.Views.ExpensesView">

    <VerticalStackLayout Padding="10" Spacing="10">
        <Label Text="Expense Tracker" FontSize="24" FontAttributes="Bold" />

        <!-- Add Previous Year Button -->
        <Button Text="Add Previous Year" Command="{Binding AddPreviousYearCommand}" />

        <!-- Year Hierarchy -->
        <CollectionView ItemsSource="{Binding Years}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <toolkit:Expander IsExpanded="{Binding IsExpanded}">
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding YearValue}" FontAttributes="Bold" />
                                <Button Text="Add Month" Command="{Binding AddMonthCommand}" />
                            </Grid>
                        </toolkit:Expander.Header>
                        <VerticalStackLayout>
                            <!-- Months for this year -->
                            <CollectionView ItemsSource="{Binding Months}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <toolkit:Expander IsExpanded="{Binding IsExpanded}">
                                            <toolkit:Expander.Header>
                                                <Grid ColumnDefinitions="2*,*,Auto,Auto,Auto">
                                                    <VerticalStackLayout Grid.Column="0">
                                                        <Label Text="{Binding MonthName}" FontAttributes="Bold" />
                                                        <Label Text="{Binding TransactionCount, StringFormat='Transactions: {0}'}" FontSize="12" />
                                                    </VerticalStackLayout>
                                                    <Picker Grid.Column="1" ItemsSource="{Binding Source={x:Reference RootView}, Path=BindingContext.Budgets}" SelectedItem="{Binding SelectedBudget}" ItemDisplayBinding="{Binding Name}" />
                                                    <Button Grid.Column="2" Text="+" Command="{Binding AddExpenseCommand}" />
                                                    <Button Grid.Column="3" Text="˅" Command="{Binding ToggleExpandCommand}" />
                                                </Grid>
                                            </toolkit:Expander.Header>
                                            <VerticalStackLayout>
                                                <!-- Expenses for this month -->
                                                <CollectionView ItemsSource="{Binding Expenses}" SelectionMode="None">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="10" ColumnDefinitions="*,Auto">
                                                                <VerticalStackLayout Grid.Column="0">
                                                                    <Label Text="{Binding Destination}" FontAttributes="Bold" />
                                                                    <Label Text="{Binding Category}" />
                                                                    <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12" TextColor="Gray" />
                                                                    <Label Text="{Binding Details}" FontSize="12" />
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="1" Text="{Binding Amount, StringFormat='${0}'}" FontAttributes="Bold" VerticalOptions="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                                <Button Text="Add Expense" Command="{Binding AddExpenseCommand}" />
                                            </VerticalStackLayout>
                                        </toolkit:Expander>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </toolkit:Expander>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Next Year Button -->
        <Button Text="Add Next Year" Command="{Binding AddNextYearCommand}" />
    </VerticalStackLayout>
</ContentView>