<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoneyCenter.Views.WelcomePage"
             Title="Welcome"
             BackgroundColor="{StaticResource AppBackgroundLight}">
    <Grid RowDefinitions="*,Auto" Padding="40" BackgroundColor="{StaticResource AppBackgroundLight}">
        <CarouselView x:Name="carousel" ItemsSource="{Binding Pages}">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Label Text="{Binding Title}"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource AppForegroundLight}" />
                        <Label Text="{Binding Description}"
                               FontSize="18"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource AppForegroundLight}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <Button Grid.Row="1"
                Text="Continue"
                Command="{Binding ContinueCommand}"
                Style="{StaticResource OutlineButtonStyle}"
                BackgroundColor="{StaticResource AppBackgroundLight}"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Fill"
                Margin="0,24" />
    </Grid>
</ContentPage>
