<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoneyCenter.ViewModel"
             xmlns:objects="clr-namespace:MoneyCenter.ViewModel.Objects"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:MoneyCenter.Converters"
             x:Class="MoneyCenter.Views.BudgetsView"
             x:DataType="viewmodel:BudgetsViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ContentView.Resources>
        <converters:CategoryTypeToColorConverter x:Key="CategoryTypeToColorConverter" />
    </ContentView.Resources>

    <ContentView.Content>
        <ScrollView HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout Padding="20" Spacing="30" HorizontalOptions="Fill">
            
            <!-- BUDGET TEMPLATES SECTION -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Budget Templates" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AppForegroundLight}, Dark={StaticResource AppForegroundDark}}" />
                            <Label Text="Create and manage your budget templates. The default budget will be used for new months." FontSize="14" TextColor="{AppThemeBinding Light={StaticResource AppMutedForegroundLight}, Dark={StaticResource AppMutedForegroundDark}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+ New Budget" Command="{Binding AddBudgetCommand}" Style="{StaticResource Button}" VerticalOptions="Start" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Budgets}" Spacing="15">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:BudgetWrapper">
                                <Border Style="{StaticResource CardStyle}" Padding="0" BackgroundColor="{AppThemeBinding Light={StaticResource AppSurface2Light}, Dark={StaticResource AppSurface2Dark}}">
                                    <toolkit:Expander>
                                        <toolkit:Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto" Padding="15">
                                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                                        <Label Text="{Binding Budget.Name}" FontSize="18" FontAttributes="Bold" />
                                                        <Border IsVisible="{Binding Budget.IsDefault}" Style="{StaticResource PillStyle}" BackgroundColor="{AppThemeBinding Light={StaticResource AppSurface1Light}, Dark={StaticResource AppSurface1Dark}}">
                                                            <Label Text="Default" Style="{StaticResource PillTextStyle}" TextColor="{AppThemeBinding Light={StaticResource AppMutedForegroundLight}, Dark={StaticResource AppMutedForegroundDark}}" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding Categories.Count, StringFormat='{0} categories in this template.'}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource AppMutedForegroundLight}, Dark={StaticResource AppMutedForegroundDark}}" Margin="0,5,0,0" />
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                                    <Button Text="Edit" Style="{StaticResource Button}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource AppForegroundLight}, Dark={StaticResource AppForegroundDark}}" BorderWidth="1" BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                                    <Button IsVisible="{Binding Budget.IsDefault, Converter={toolkit:InvertedBoolConverter}}" Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:BudgetsViewModel}}, Path=DeleteBudgetCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Destructive}" TextColor="White" />
                                                    <Label Text="▼" FontSize="16" VerticalOptions="Center" Margin="5,0,0,0" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </toolkit:Expander.Header>
                                        
                                        <!-- Expanded Categories Grid inside Budget -->
                                        <VerticalStackLayout Padding="15" BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">
                                            <Grid ColumnDefinitions="2*,*,*,Auto" Padding="10" Margin="0,0,0,10">
                                                <Label Grid.Column="0" Text="Category" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="Frequency" FontAttributes="Bold" />
                                                <Label Grid.Column="2" Text="Amount" FontAttributes="Bold" HorizontalTextAlignment="End" Margin="0,0,20,0" />
                                                <Label Grid.Column="3" Text="Actions" FontAttributes="Bold" HorizontalTextAlignment="Center" WidthRequest="60" />
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" Margin="0,-10,0,10" />
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="5">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="objects:BudgetMasterCategory">
                                                        <Grid ColumnDefinitions="2*,*,*,Auto" Padding="10">
                                                            <Label Grid.Column="0" Text="{Binding MasterCategoryId, StringFormat='ID: {0}'}" VerticalOptions="Center" />
                                                            <Border Grid.Column="1" Style="{StaticResource PillStyle}">
                                                                <Label Style="{StaticResource PillTextStyle}" Text="{Binding IsRecurring, StringFormat='Recurring: {0}'}" />
                                                            </Border>
                                                            <Label Grid.Column="2" Text="{Binding Amount, StringFormat='${0:F2}'}" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" Margin="0,0,20,0" />
                                                            <Button Grid.Column="3" Text="🗑" BackgroundColor="Transparent" TextColor="{StaticResource Destructive}" WidthRequest="40" Padding="0" VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </toolkit:Expander>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- MASTER CATEGORY LIST SECTION -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Master Category List" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AppForegroundLight}, Dark={StaticResource AppForegroundDark}}" />
                            <Label Text="Define the default properties for all categories in your app." FontSize="14" TextColor="{AppThemeBinding Light={StaticResource AppMutedForegroundLight}, Dark={StaticResource AppMutedForegroundDark}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+ Add Category" Command="{Binding AddCategoryCommand}" Style="{StaticResource Button}" BackgroundColor="{AppThemeBinding Light={StaticResource AppSurface2Light}, Dark={StaticResource AppSurface2Dark}}" TextColor="{AppThemeBinding Light={StaticResource AppForegroundLight}, Dark={StaticResource AppForegroundDark}}" VerticalOptions="Start" />
                    </Grid>

                    <VerticalStackLayout BackgroundColor="{AppThemeBinding Light={StaticResource AppSurface1Light}, Dark={StaticResource AppSurface1Dark}}" Padding="15" Spacing="10">
                        <Grid ColumnDefinitions="3*,2*,Auto" Padding="10" Margin="0,0,0,10">
                            <Label Grid.Column="0" Text="Category" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="Type" FontAttributes="Bold"/>
                            <Label Grid.Column="2" Text="Actions" FontAttributes="Bold" WidthRequest="60" HorizontalTextAlignment="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" Margin="0,-10,0,10" />
                        
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MasterCategories}" Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="objects:MasterCategory">
                                    <Grid ColumnDefinitions="3*,2*,Auto" Padding="10">
                                        <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontAttributes="Bold"/>
                                        <Border Grid.Column="1" Style="{StaticResource PillStyle}"
                                                BackgroundColor="{Binding Type, Converter={StaticResource CategoryTypeToColorConverter}}">
                                            <Label Style="{StaticResource PillTextStyle}" Text="{Binding Type}" />
                                        </Border>
                                        <HorizontalStackLayout Grid.Column="2" WidthRequest="60" HorizontalOptions="Center">
                                            <Button Text="🗑" BackgroundColor="Transparent" TextColor="{StaticResource Destructive}" Padding="0" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:BudgetsViewModel}}, Path=DeleteCategoryCommand}" CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
        </ScrollView>
    </ContentView.Content>
</ContentView>
